{
  "name": "browser-review",
  "version": "0.3.1",
  "description": "Point at an element in your browser, leave a comment, and let your local coding agent fix the code behind it.",
  "license": "Apache-2.0",
  "author": "kechol",
  "homepage": "https://github.com/kechol/browser-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kechol/browser-review.git",
    "directory": "packages/browser-review"
  },
  "bugs": "https://github.com/kechol/browser-review/issues",
  "keywords": [
    "claude-code",
    "mcp",
    "code-review",
    "browser",
    "annotation",
    "localhost"
  ],
  "type": "module",
  "bin": {
    "browser-review": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^5.0.0",
    "parse5": "^8.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@browser-review/shared": "workspace:*",
    "playwright": "^1.63.0"
  }
