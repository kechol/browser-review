{
  "name": "@browser-review/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin that tags JSX elements with data-review-src so browser-review can jump straight to the source line.",
  "license": "Apache-2.0",
  "author": "kechol",
  "homepage": "https://github.com/kechol/browser-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kechol/browser-review.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": "https://github.com/kechol/browser-review/issues",
  "keywords": [
    "vite-plugin",
    "jsx",
    "browser-review",
    "source-mapping"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@babel/parser": "^8.0.5"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "vite": "^8.3.0"
  }
}
