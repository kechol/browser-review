{
  "name": "browser-review-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --build --force && pnpm --filter browser-review-example-vite-react typecheck",
    "lint": "oxlint packages scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "license-check": "node scripts/check-licenses.mjs",
    "check:no-egress": "node scripts/check-no-egress.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "version-packages": "changeset version && node scripts/sync-plugin-version.mjs && oxfmt --write .claude-plugin .mcp.json && pnpm install --lockfile-only",
    "release": "pnpm run build && pnpm run check:packages && changeset publish",
    "check:packages": "node scripts/check-packages.mjs",
    "homebrew:formula": "node scripts/generate-homebrew-formula.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "oxfmt": "^0.68.0"
  },
  "packageManager": "pnpm@12.5.1"
}
